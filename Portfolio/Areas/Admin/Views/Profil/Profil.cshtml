@model Portfolio.Models.Entities.kullanici

@{
    ViewData["Title"] = "Profil Ayarları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-4">
      
        <div class="card shadow mb-4 text-center p-4">
            <div class="small text-muted mb-3 bg-light p-2 rounded border">
                <i class="fas fa-file-image mr-1 text-primary"></i> <strong>Yüklü Dosya Yol / Adı:</strong><br />
                <code>@(Model?.foto_url ?? "Varsayılan resim (undraw_profile.svg)")</code>
            </div>
            <h5>@(Model?.isim) @(Model?.soyisim)</h5>
            <p class="text-muted">@(Model?.unvan)</p>
        </div>
    </div>

    <div class="col-lg-8">
        
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Profil Bilgilerimi Düzenle</h6>
            </div>
            <div class="card-body">

                @if (ViewBag.Mesaj != null)
                {
                    <div class="alert alert-success">@ViewBag.Mesaj</div>
                }
                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger">@ViewBag.Hata</div>
                }

                
                <form asp-area="Admin" asp-controller="Profil" asp-action="Profil" method="post" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Adınız</label>
                            <input type="text" name="isim" value="@Model?.isim" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Soyadınız</label>
                            <input type="text" name="soyisim" value="@Model?.soyisim" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Unvanınız</label>
                        <input type="text" name="unvan" value="@Model?.unvan" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hakkımda</label>
                        <textarea name="hakkimda" class="form-control" rows="4">@Model?.hakkimda</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Yeni Profil Fotoğrafı Yükle</label>
                        <input type="file" name="profilFoto" class="form-control" accept="image/*" />
                        <small class="form-text text-muted">Fotoğrafı değiştirmek istemiyorsanız boş bırakabilirsiniz.</small>
                    </div>

                    <div class="text-right">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fas fa-save mr-1"></i> Bilgileri Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
