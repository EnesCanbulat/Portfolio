@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-white d-flex align-items-center justify-content-center vh-100">

    <div class="card bg-secondary text-white p-4 shadow" style="width: 350px;">
        <h3 class="text-center mb-4">Admin Girişi</h3>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger py-2 text-center" role="alert">
                @ViewBag.Hata
            </div>
        }

        <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login">
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" class="form-control" name="kullanici_adi" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password" class="form-control" name="sifre" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Giriş Yap</button>
        </form>
    </div>

</body>
</html>