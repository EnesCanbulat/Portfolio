@model List<Portfolio.Models.Entities.duyurular>

@{
    ViewData["Title"] = "Duyurularım";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<a href="/Admin/Duyuru/Ekle" class="btn btn-sm btn-primary shadow-sm">
    <i class="fas fa-plus fa-sm text-white-50"></i> Yeni Duyuru Ekle
</a>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Tüm Duyurular Listesi</h6>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Kategori</th>
                            <th>Başlık</th>
                            <th>İçerik</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var duyuru in Model)
                        {
                            <tr>
                                <td>@duyuru.gonderitarihi.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge bg-info text-white">@duyuru.kategori</span></td>
                                <td>@duyuru.baslik</td>
                                <td>@duyuru.icerik</td>
                                <td>
                                    <a href="#" class="btn btn-warning btn-sm" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-area="Admin" asp-controller="Duyuru" asp-action="Sil" asp-route-id="@duyuru.id" method="post" class="d-inline" onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Sil">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                Henüz veritabanında kayıtlı bir duyuru bulunmamaktadır.
            </div>
        }
    </div>
</div>