@{
    ViewData["Title"] = "Yeni Proje Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow mb-4" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Yeni Proje Ekle</h6>
    </div>
    <div class="card-body">
        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger">@ViewBag.Hata</div>
        }

        <form asp-area="Admin" asp-controller="Proje" asp-action="Ekle" method="post">
            <div class="mb-3">
                <label class="form-label">Proje Adı</label>
                <input type="text" name="proje" class="form-control" placeholder="Örn: E-Ticaret Otomasyonu" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Proje Açıklaması</label>
                <textarea name="aciklama" class="form-control" rows="5" placeholder="Projede kullanılan teknolojiler ve detaylar..." required></textarea>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/Admin/Proje/Projeler" class="btn btn-secondary">İptal</a>
                <button type="submit" class="btn btn-success px-4">Projeyi Kaydet</button>
            </div>
        </form>
    </div>
</div>
